{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nexus.agent-tool-manifest.v1",
  "title": "NEXUS Agent Tool Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "identity",
    "source",
    "contract",
    "delivery",
    "permissions",
    "verification",
    "ratings",
    "evolution"
  ],
  "properties": {
    "schema": { "const": "nexus.agent-tool-manifest.v1" },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "version", "summary", "categories"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{2,80}$" },
        "name": { "type": "string", "minLength": 3, "maxLength": 100 },
        "version": { "type": "string", "pattern": "^v?[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$" },
        "summary": { "type": "string", "minLength": 12, "maxLength": 240 },
        "categories": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit", "license", "artifactSha256"],
      "properties": {
        "repository": { "type": "string", "minLength": 3 },
        "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "license": { "type": "string", "minLength": 2 },
        "attribution": { "type": "string" },
        "artifactSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "upstream": { "type": "array", "items": { "type": "object" } }
      }
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inputs", "outputs", "errors", "deterministic"],
      "properties": {
        "inputs": { "type": "object" },
        "outputs": { "type": "object" },
        "errors": { "type": "array", "items": { "type": "object" } },
        "deterministic": { "type": "boolean" },
        "examples": { "type": "array", "items": { "type": "object" } }
      }
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["web", "offlineCapable", "deviceProfiles", "bundleBytes"],
      "properties": {
        "web": { "type": "boolean" },
        "pwa": { "type": "boolean" },
        "offlineCapable": { "type": "boolean" },
        "entrypoint": { "type": ["string", "null"] },
        "bundleBytes": { "type": "integer", "minimum": 0 },
        "deviceProfiles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "iphone-mobile-web",
              "generic-mobile-web",
              "desktop-web",
              "windows-pwa",
              "windows-handheld-controller",
              "webgpu-high-performance"
            ]
          }
        }
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["network", "storage", "clipboard", "filesystem", "credentials", "destructive"],
      "properties": {
        "network": { "type": "array", "items": { "type": "string" } },
        "storage": { "enum": ["none", "memory", "localStorage", "indexedDB"] },
        "clipboard": { "type": "boolean" },
        "filesystem": { "type": "boolean" },
        "credentials": { "type": "boolean" },
        "destructive": { "type": "boolean" }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "artifactSha256", "tests", "evidence", "verifiedAt"],
      "properties": {
        "status": { "enum": ["unverified", "blocked", "candidate", "verified", "revoked"] },
        "artifactSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "tests": { "type": "array", "items": { "type": "object" } },
        "evidence": { "type": "array", "items": { "type": "object" } },
        "verifiedAt": { "type": ["string", "null"], "format": "date-time" },
        "verifierIdentity": { "type": ["string", "null"] },
        "knownLimits": { "type": "array", "items": { "type": "string" } }
      }
    },
    "ratings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verifiedRuns", "failedRuns", "human", "agentCompatibility", "mobileQuality", "clarity"],
      "properties": {
        "verifiedRuns": { "type": "integer", "minimum": 0 },
        "failedRuns": { "type": "integer", "minimum": 0 },
        "human": { "$ref": "#/$defs/rating" },
        "agentCompatibility": { "$ref": "#/$defs/rating" },
        "mobileQuality": { "$ref": "#/$defs/rating" },
        "clarity": { "$ref": "#/$defs/rating" },
        "security": { "$ref": "#/$defs/rating" },
        "reuse": { "$ref": "#/$defs/rating" }
      }
    },
    "evolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parentVersion", "generation", "mutationSummary", "fitness", "eligibleForSelection"],
      "properties": {
        "parentVersion": { "type": ["string", "null"] },
        "generation": { "type": "integer", "minimum": 0 },
        "mutationSummary": { "type": "string", "maxLength": 500 },
        "fitness": { "type": "number" },
        "eligibleForSelection": { "type": "boolean" },
        "regressions": { "type": "array", "items": { "type": "string" } },
        "candidateBranch": { "type": ["string", "null"] }
      }
    }
  },
  "$defs": {
    "rating": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score", "count"],
      "properties": {
        "score": { "type": "number", "minimum": 0, "maximum": 5 },
        "count": { "type": "integer", "minimum": 0 },
        "evidenceBoundCount": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
